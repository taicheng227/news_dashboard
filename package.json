{
  "name": "ai-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A durable personal AI-news archive and finite daily newsletter.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-database.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/run-backup.js",
    "collect": "node --env-file-if-exists=.env --import tsx scripts/trigger-collection.ts",
    "collect:local": "node --env-file-if-exists=.env --import tsx scripts/collect-local.ts",
    "collect:smoke": "node --env-file-if-exists=.env --import tsx scripts/collect-smoke.ts",
    "youtube:resolve": "node --env-file-if-exists=.env --import tsx scripts/resolve-youtube-channel.ts",
    "newsletter:daily": "node --env-file-if-exists=.env --import tsx scripts/run-daily-newsletter.ts",
    "cron:collection": "node --env-file-if-exists=.env --import tsx scripts/cron-collection.ts",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "eta": "^4.6.0",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.11.2",
    "marked": "^18.0.9",
    "sanitize-html": "^2.17.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
