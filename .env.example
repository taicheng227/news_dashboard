# Web service. Railway should mount its persistent volume at /data.
DATABASE_PATH=./data/ai-radar.sqlite
PORT=3000
HOST=0.0.0.0
DASHBOARD_USERNAME=radar
DASHBOARD_PASSWORD=replace-with-a-long-password
AI_RADAR_ADMIN_TOKEN=replace-with-a-separate-long-token

# Trusted Codex runner / cron trigger.
AI_RADAR_BASE_URL=http://127.0.0.1:3000
# Required on the trusted runner; choose deliberately so each run records the
# exact Codex configuration it used.
AI_RADAR_MODEL=
AI_RADAR_REASONING_EFFORT=
AI_RADAR_PROMPT_VERSION=v1

# Manual SQLite backup retention.
AI_RADAR_BACKUP_DIR=./data/manual-backups
AI_RADAR_BACKUP_RETENTION=7
