<section class="hero">
  <div>
    <p class="eyebrow">DAILY SIGNAL<% if (it.newsletter) { %> / <%= it.newsletter.newsletter_date.replaceAll("-", ".") %><% } %></p>
    <h1><%= it.newsletter ? it.newsletter.title : "Ready for the first edition" %></h1>
    <p class="lede"><%= it.newsletter ? it.newsletter.dek : "Collect the configured sources, then run the trusted Codex newsletter workflow." %></p>
  </div>
  <div class="radar-mark" aria-hidden="true"><span></span><i></i></div>
</section>
<% if (it.newsletter) { %>
<section class="edition-meta">
  <span><strong><%= it.formatDate(it.newsletter.newsletter_date) %></strong></span>
  <span>Published <%= it.formatDateTime(it.newsletter.published_at) %></span>
  <span><%= it.stats.assessed %> assessed · <%= it.stats.archived %> archived</span>
</section>
<% for (const section of it.sections) { %>
  <% if (section.entries.length) { %>
  <section class="newsletter-section">
    <p class="section-kicker"><%= section.title %></p>
    <% for (const entry of section.entries) { %>
    <article class="story">
      <h2><%= entry.headline %></h2>
      <p class="summary"><%= entry.summary %></p>
      <h3>Why it matters</h3>
      <p><%= entry.why_it_matters %></p>
      <% if (entry.caveats.length) { %><ul class="caveats"><% for (const caveat of entry.caveats) { %><li><%= caveat %></li><% } %></ul><% } %>
      <% if (entry.sources.length) { %><p class="sources"><span>Sources</span><% for (const source of entry.sources) { %> <a href="<%= source.canonical_url %>" rel="noreferrer"><%= source.title %></a><% } %></p><% } %>
    </article>
    <% } %>
  </section>
  <% } %>
<% } %>
<section class="caught-up"><span class="check">✓</span><div><p>RADAR CLEAR</p><h2>You're caught up.</h2></div><p>Close the tab. Go make something.</p></section>
<% } else { %>
<section class="empty-state"><h2>No newsletter has been published yet.</h2><p>The archive will appear here after the first successful deterministic import.</p></section>
<% } %>
